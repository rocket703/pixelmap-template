---
/**
 * Selbst gezeichnete 16×16-Pixel-Symbole (keine Marken-Logos).
 * Ausgeschnittene Flächen über fill-rule="evenodd".
 */
import type { LinkIcon } from '../data/links';

interface Props {
  name: LinkIcon | 'share';
}
const { name } = Astro.props;

const PATHS: Record<Props['name'], string> = {
  // Bildschirm mit Standfuß (Livestream)
  twitch: 'M1 2h14v10H1zM3 4v6h10V4zM6 13h4v1H6zM4 14h8v1H4z',
  // Sprechblase mit Augen (Community)
  discord: 'M2 2h12v9H8v1H7v1H6v1H5v-3H2zM5 5v2h2V5zM9 5v2h2V5z',
  // Play-Taste (Video)
  youtube: 'M1 3h14v10H1zM6 5v6h1v-1h1V9h1V7H8V6H7V5z',
  // Musiknote (Clips)
  tiktok: 'M9 2h2v1h2v1h1v2h-1V5h-2v6h-1v1H9v1H6v-1H5v-2h1V9h3z',
  // Haus (Website)
  world: 'M8 1h1v1h1v1h1v1h1v1h1v1h1v1h1v1h-2v7H3V8H1V7h1V6h1V5h1V4h1V3h1V2h2zM7 10v4h2v-4z',
  // Briefumschlag
  mail: 'M1 3h14v10H1zM2 4v8h12V4zM3 5h1v1h1v1h1v1h4V7h1V6h1V5h1v1h-1v1h-1v1h-1v1H6V8H5V7H4V6H3z',
  // Teilen: Pfeil aus Kasten
  share: 'M7 1h2v1h1v1h1v1h-2v6H7V4H5V3h1V2h1zM2 7h3v1H3v6h10V8h-2V7h3v8H2z',
};
---

<svg class="pixel-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" shape-rendering="crispEdges">
  <path fill="currentColor" fill-rule="evenodd" d={PATHS[name]}></path>
</svg>
