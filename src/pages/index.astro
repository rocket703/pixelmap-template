---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Station from '../components/Station.astro';
import { MAP, HERO, SCROLL, BUILDINGS, BUILDING_GAP, PATH_HALF, buildingBox } from '../data/map';
import { SITE, STATIONS } from '../data/stations';
import { DOG, NPC_SPRITES } from '../data/npc';
import { LAYOUTS, MOBILE_QUERY, STOPS } from '../data/layouts';
import '../styles/map.css';

// Zwei Maps (src/data/layouts.ts): Desktop und Handy. CSS und Skript wählen per MOBILE_QUERY.
const D = LAYOUTS.desktop;
const M = LAYOUTS.mobile;
const mapCfg = (L: typeof D) => ({ width: L.width, height: L.height, path: L.path, waypoints: L.waypoints });

// Nur die Daten, die das Skript braucht (Texte stehen bereits im HTML)
const config = {
  zoom: MAP.zoom,
  mobileQuery: MOBILE_QUERY,
  layouts: { desktop: mapCfg(D), mobile: mapCfg(M) },
  hero: {
    speed: HERO.speed,
    sprintFrom: HERO.sprintFrom,
    sprintMax: HERO.sprintMax,
    stride: HERO.stride,
    anchorX: HERO.anchorX,
    anchorY: HERO.anchorY,
  },
  scroll: SCROLL,
  stations: STOPS.map((s) => ({
    id: s.id,
    panel: 'panel' in s ? s.panel : 'right',
    face: s.face ?? 'up',
    halfW: BUILDINGS[s.building].w / 2,
    h: BUILDINGS[s.building].h,
  })),
  gap: BUILDING_GAP,
  pathHalf: PATH_HALF,
};

// Gebäude und Schilder bekommen beide Positionen (--dx/--dy Desktop, --mx/--my Handy)
const buildings = STOPS.map((s, i) => ({
  station: s,
  d: buildingBox(s.building, D.path[D.waypoints[i]]),
  m: buildingBox(s.building, M.path[M.waypoints[i]]),
  frames: BUILDINGS[s.building].frames ?? 1,
}));
const parkStyle = `--dx:${D.park.x};--dy:${D.park.y};--dw:${D.park.w};--mx:${M.park.x};--my:${M.park.y};--mw:${M.park.w};--h:${D.park.h}`;

// Hundeplatz: Bulldogge und Entenküken (Easter Egg, siehe src/data/npc.ts)
const npcConfig = {
  mobileQuery: MOBILE_QUERY,
  parks: { desktop: D.park, mobile: M.park },
  dog: { walk: DOG.walk, run: DOG.run, anchorX: NPC_SPRITES.dog.anchorX, anchorY: NPC_SPRITES.dog.anchorY },
  duck: { anchorX: NPC_SPRITES.duck.anchorX, anchorY: NPC_SPRITES.duck.anchorY },
};
const npcStyle = (key: keyof typeof NPC_SPRITES) => {
  const sp = NPC_SPRITES[key];
  return `--src:url(${url(sp.src)});--fw:${sp.frameW};--fh:${sp.frameH};--rows:${sp.rows}`;
};

const heroStyle = [
  `--src:url(${url(HERO.src)})`,
  `--fw:${HERO.frameW}`,
  `--fh:${HERO.frameH}`,
  `--frames:${HERO.frames}`,
  `--walk-dur:${(HERO.stride / HERO.speed).toFixed(3)}s`,
].join(';');
---

<Base bodyClass="map-page">
  <SiteHeader onMap />

  <div
    class="map"
    id="map"
    style={`--dmap-w:${D.width};--dmap-h:${D.height};--mmap-w:${M.width};--mmap-h:${M.height}`}
    aria-hidden="true"
  >
    <div class="world" id="world">
      <!-- <picture>: der Browser lädt nur die Ebenen der passenden Map -->
      <picture>
        <source media={MOBILE_QUERY} srcset={url(M.layers.ground)} width={M.width} height={M.height} />
        <img class="layer" src={url(D.layers.ground)} width={D.width} height={D.height} alt="" fetchpriority="high" />
      </picture>
      <picture>
        <source media={MOBILE_QUERY} srcset={url(M.layers.objects)} width={M.width} height={M.height} />
        <img class="layer" src={url(D.layers.objects)} width={D.width} height={D.height} alt="" />
      </picture>
      {
        /* Gebäude als Sprite-Sheet: Frame 0 normal, Frame 1 (falls vorhanden) bei Ankunft der Figur */
        buildings.map(({ station: s, d, m, frames }) => (
          <div
            class="building"
            data-building={s.id}
            data-frames={frames}
            style={`--src:url(${url(`/assets/buildings/${s.building}.png`)});--dx:${d.x};--dy:${d.y};--mx:${m.x};--my:${m.y};--w:${d.w};--h:${d.h};--frames:${frames}`}
          />
        ))
      }
      <div class="park" id="park" style={parkStyle}></div>
      {Array.from({ length: D.park.ducks }, () => <span class="npc duck" style={npcStyle('duck')}></span>)}
      <button class="npc dog" id="dog" type="button" tabindex="-1" title={`${DOG.name} anklicken`} style={npcStyle('dog')}></button>
      <div class="hero" id="hero" style={heroStyle}></div>
      <picture>
        <source media={MOBILE_QUERY} srcset={url(M.layers.canopy)} width={M.width} height={M.height} />
        <img class="layer" src={url(D.layers.canopy)} width={D.width} height={D.height} alt="" />
      </picture>
      {
        /* Schilder über den Gebäuden: Klick schickt die Figur hin (Tastatur nutzt die Navigation) */
        buildings.map(({ station: s, d, m }) => (
          <a
            class="sign"
            href={`#${s.id}`}
            data-nav={s.id}
            tabindex="-1"
            style={`--dx:${d.x + d.w / 2};--dy:${d.y};--mx:${m.x + m.w / 2};--my:${m.y}`}
          >
            {s.nav}
          </a>
        ))
      }
    </div>
  </div>

  <!-- Zeigt an, wo die Figur gerade ist, wenn sie beim schnellen Scrollen aus dem Bild fällt -->
  <div class="hero-hint" id="hero-hint" aria-hidden="true">
    <span class="hero-hint-arrow"></span>{SITE.hero} läuft hinterher …
  </div>

  <main id="inhalt" class="stations">
    {STATIONS.map((s, i) => <Station station={s} index={i} />)}
  </main>

  <!-- Easter Egg: erscheint beim Klick auf den Hund -->
  <aside class="npc-card box" id="npc-card" hidden aria-labelledby="npc-card-title">
    <button class="npc-card-close" type="button" aria-label="Schließen">×</button>
    <p class="kicker">{DOG.kicker}</p>
    <h2 id="npc-card-title">{DOG.name}</h2>
    <p>{DOG.text}</p>
    <ul>
      {DOG.facts.map((f) => <li>{f}</li>)}
    </ul>
  </aside>

  <SiteFooter />

  <script is:inline type="application/json" id="map-config" set:html={JSON.stringify(config)} />
  <script is:inline type="application/json" id="npc-config" set:html={JSON.stringify(npcConfig)} />
  <script>
    import { initMap } from '../scripts/map';
    import { initNpc } from '../scripts/npc';
    initMap();
    initNpc();
  </script>
</Base>
